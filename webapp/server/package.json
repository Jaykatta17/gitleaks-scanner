{
  "name": "@sentinel/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sentinel Console API — enterprise secret-scanning management platform",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
