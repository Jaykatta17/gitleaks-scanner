# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=Sentinel Console
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
TRUST_PROXY=false
LOG_LEVEL=info

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/sentinel
MONGO_MAX_POOL=20

# ─── Redis (queue backend) ───────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=sentinel
SCAN_CONCURRENCY=2
EMAIL_CONCURRENCY=5
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=10000

# ─── JWT / session ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=sentinel-console

# ─── Password / lockout policy ───────────────────────────────────────────────
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY=5
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
RESET_TOKEN_MINUTES=30
MFA_ISSUER=Sentinel Console
REQUIRE_MFA_FOR_ADMINS=false

# ─── LDAP / Active Directory ─────────────────────────────────────────────────
LDAP_ENABLED=false
LDAP_URL=ldaps://dc01.corp.local:636
LDAP_BIND_DN=CN=svc-sentinel,OU=Service Accounts,DC=corp,DC=local
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=DC=corp,DC=local
LDAP_SEARCH_FILTER=(|(uid={{username}})(sAMAccountName={{username}}))
LDAP_GROUP_SEARCH_BASE=OU=Groups,DC=corp,DC=local
LDAP_GROUP_SEARCH_FILTER=(member={{dn}})
LDAP_ATTR_USERNAME=sAMAccountName
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_DISPLAY_NAME=displayName
LDAP_ATTR_DEPARTMENT=department
# groupDN:role pairs, comma separated. Roles: admin | security_analyst | developer | viewer
LDAP_ROLE_MAPPINGS=CN=SecOps,OU=Groups,DC=corp,DC=local:admin,CN=AppSec,OU=Groups,DC=corp,DC=local:security_analyst,CN=Developers,OU=Groups,DC=corp,DC=local:developer
LDAP_DEFAULT_ROLE=viewer
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_TIMEOUT_MS=8000

# ─── SMTP ────────────────────────────────────────────────────────────────────
# When disabled, messages are rendered and logged instead of sent.
SMTP_ENABLED=false
SMTP_HOST=smtp.corp.local
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sentinel Console <no-reply@corp.local>
SMTP_REPLY_TO=appsec@corp.local
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_POOL_SIZE=3

# ─── Syslog auditing ─────────────────────────────────────────────────────────
SYSLOG_ENABLED=false
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=514
SYSLOG_PROTOCOL=udp          # udp | tcp
SYSLOG_FACILITY=13           # 13 = log audit
SYSLOG_RFC=5424              # 5424 | 3164
SYSLOG_APP_NAME=sentinel
AUDIT_RETENTION_DAYS=400
AUDIT_LOG_REQUEST_BODIES=true

# ─── Scanner ─────────────────────────────────────────────────────────────────
SCAN_DRIVER=mock             # mock | native | docker
GITLEAKS_IMAGE=zricethezav/gitleaks:latest
GITLEAKS_BIN=gitleaks
SCAN_CLONE_DEPTH=50
SCAN_TIMEOUT_MS=900000
SCAN_MAX_FINDINGS=5000
SCAN_REDACT_SECRETS=true
